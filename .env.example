# Copy to .env in this folder and fill in. Never share or commit real values.
# Put passwords in single quotes; they are used exactly as written.
TE_UI_USERNAME=admin
# The appliance's initial web-UI password (used only by change_password.py to sign in the first time).
TE_DEFAULT_PASSWORD=''
# The new web-UI password: set by change_password.py, then used by load_keys.py.
TE_UI_PASSWORD=''
# SSH settings for load_keys.py (public key only) and verify_ssh.py.
TE_SSH_USERNAME=thousandeyes
TE_SSH_PUBLIC_KEY_PATHS=~/.ssh/teva_ed25519.pub
TE_SSH_PRIVATE_KEY=~/.ssh/teva_ed25519
# Leave empty for an unencrypted key, or to be asked for the passphrase.
TE_SSH_PRIVATE_KEY_PASSPHRASE=
TE_SSH_PORT=22
TE_SSH_KNOWN_HOSTS=~/.ssh/known_hosts
